# Copy this file to .env and paste each key right after its = sign (no spaces, no quotes).
# .env is ignored by git. Never commit it and never paste keys in a chat.

# virustotal.com -> your profile picture (top right) -> API key
VIRUSTOTAL_API_KEY=

# urlscan.io -> your profile (top right) -> Settings & API -> New API key
URLSCAN_API_KEY=

# abuseipdb.com -> Account -> API -> Create Key
ABUSEIPDB_API_KEY=

# Optional settings (the defaults are shown).
# Server IDs of YOUR receiving mail servers, comma-separated (e.g. mx.google.com).
# Empty = trust the top-most Authentication-Results header, which Microsoft 365 needs
# because it writes no server ID.
TRUSTED_AUTHSERV_IDS=
# Re-check DKIM signatures with a DNS lookup of the signing key. "off" avoids
# any lookup that the sending domain's DNS servers could notice.
DKIM_RECHECK=on
# urlscan.io scans: private (only you can see them) or unlisted. Public is never used.
URLSCAN_VISIBILITY=private
URLSCAN_DAILY_SCANS=50
# Your organization's own domains, comma-separated (e.g. company.tn). Lookalikes of them
# (c0mpany.tn, company-tn.com) are the core of business email compromise.
PROTECTED_DOMAINS=
# A different brand list (default: phishtriage/data/brands.toml).
BRANDS_FILE=
# Lookups per email. 4 is VirusTotal's free per-minute limit, so one email never waits.
VIRUSTOTAL_MAX_PER_EMAIL=4
URLSCAN_MAX_PER_EMAIL=2
